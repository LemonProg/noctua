[Unit]
Description=Agence IA - sauvegarde compressée de la base

[Service]
Type=oneshot
User=agence
Group=agence
WorkingDirectory=/srv/agence-ia/app
ExecStart=/srv/agence-ia/app/.venv/bin/agence sauvegarde
Environment=PATH=/srv/agence-ia/.local/bin:/usr/local/bin:/usr/bin:/bin
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/agence-ia
