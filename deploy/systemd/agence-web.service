[Unit]
Description=Agence IA - interface web de validation
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agence
Group=agence
WorkingDirectory=/srv/agence-ia/app
ExecStart=/srv/agence-ia/app/.venv/bin/agence web
Environment=PATH=/srv/agence-ia/.local/bin:/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/agence-ia /var/tmp/agence-ia

[Install]
WantedBy=multi-user.target
