# Copy this file to .env and fill in the values. Never commit .env.
# More optional settings exist (night hours, ntfy, loudness…): see the README.

# --- Agency ---
# Name shown in the interface, the installed app and notifications
NOM_AGENCE=My agency

# --- Paths (relative to the project root, or absolute) ---
# Footage and produced content
DOSSIER_CONTENUS=/srv/agence-ia/contenus
# Work files, deleted after each task
DOSSIER_TEMP=/var/tmp/agence-ia
# SQLite database (task queue, content, costs, lessons)
CHEMIN_BASE=/srv/agence-ia/agence.sqlite3
# Daily compressed database backups
DOSSIER_SAUVEGARDES=/srv/agence-ia/sauvegardes

# --- Disk (free space, in GB) ---
# Below this threshold: alert in the interface
DISQUE_SEUIL_ALERTE_GO=5
# Below this threshold (after upload): new footage refused. Must be lower than the alert threshold.
DISQUE_SEUIL_REFUS_GO=2

# --- Retention ---
# Delay before a trashed item is deleted (extended while its analysis is not finished)
CORBEILLE_DELAI_HEURES=24
# Delay before content is deleted after publication
PUBLICATION_DELAI_JOURS=7

# --- Costs (optional paid APIs; none used by default) ---
# Monthly cap in dollars. 0 = no paid call allowed.
PLAFOND_COUTS_MENSUEL_USD=0

# --- Claude: Claude subscription (Pro or Max), via the `claude` command, WITHOUT an API key ---
# Above this subscription usage rate (5-hour or 7-day window), the agency pauses until the reset:
# the subscription is also yours to use.
QUOTA_SEUIL_POURCENT=90
# Token generated once with `claude setup-token` (valid for one year). Secret.
CLAUDE_CODE_OAUTH_TOKEN=
# Claude Code configuration folder reserved for the agency, isolated from yours
DOSSIER_CONFIG_CLAUDE=/srv/agence-ia/claude-config
# Never set ANTHROPIC_API_KEY: Claude Code would use it instead of the subscription (pay-per-use billing).

# --- Web interface ---
# 127.0.0.1 on the VPS (behind Caddy); 0.0.0.0 to reach it from your phone on the local Wi-Fi.
HOTE_WEB=127.0.0.1
PORT_WEB=8000
# Written by the `agence mot-de-passe` command (do not fill in by hand).
MOT_DE_PASSE_INTERFACE=
SECRET_SESSION=

# --- Push notifications on your phone (ntfy app) ---
# Secret topic: `agence notification sujet` creates one and writes it here. Empty: no notifications.
NTFY_SUJET=

# --- Instagram (official Meta API) ---
# "oui" (yes): each approved post is published at its planned time (between 8 am and 10 pm, Paris time).
# Keep "non" (no) until the Meta app, the token and the public URL are ready.
PUBLICATION_AUTOMATIQUE=non
INSTAGRAM_API_URL=https://graph.facebook.com/v23.0
# Professional Instagram account ID and access token (secret), from the Meta app.
INSTAGRAM_COMPTE_ID=
INSTAGRAM_JETON=
