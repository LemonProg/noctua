# Copier ce fichier en .env et remplir les valeurs. Ne jamais commiter .env.
# D'autres réglages facultatifs existent (horaires de nuit, ntfy, niveau sonore…) : voir le README.

# --- Agence ---
# Nom affiché dans l'interface, l'application installée et les notifications
NOM_AGENCE=Mon agence

# --- Chemins (relatifs à la racine du projet, ou absolus) ---
# Rushs et contenus produits
DOSSIER_CONTENUS=/srv/agence-ia/contenus
# Fichiers de travail, supprimés après chaque tâche
DOSSIER_TEMP=/var/tmp/agence-ia
# Base SQLite (file de tâches, contenus, coûts, leçons)
CHEMIN_BASE=/srv/agence-ia/agence.sqlite3
# Sauvegardes quotidiennes compressées de la base
DOSSIER_SAUVEGARDES=/srv/agence-ia/sauvegardes

# --- Disque (en Go d'espace libre) ---
# Sous ce seuil : alerte dans l'interface
DISQUE_SEUIL_ALERTE_GO=5
# Sous ce seuil (après ajout) : nouveau rush refusé. Doit être inférieur au seuil d'alerte.
DISQUE_SEUIL_REFUS_GO=2

# --- Conservation ---
# Délai avant suppression d'un élément en corbeille (prolongé si son analyse n'est pas finie)
CORBEILLE_DELAI_HEURES=24
# Délai avant suppression d'un contenu après sa publication
PUBLICATION_DELAI_JOURS=7

# --- Coûts (API payantes éventuelles ; aucune n'est utilisée par défaut) ---
# Plafond mensuel en dollars. 0 = aucun appel payant autorisé.
PLAFOND_COUTS_MENSUEL_USD=0

# --- Claude : abonnement Claude (Pro ou Max), via la commande `claude`, SANS clé API ---
# Au-delà de ce taux d'utilisation de l'abonnement (fenêtre de 5 h ou de 7 jours), l'agence se met en pause
# jusqu'à la remise à zéro : l'abonnement sert aussi à l'humain.
QUOTA_SEUIL_POURCENT=90
# Jeton généré une fois avec `claude setup-token` (valable un an). Secret.
CLAUDE_CODE_OAUTH_TOKEN=
# Dossier de configuration de Claude Code réservé à l'agence, isolé du vôtre
DOSSIER_CONFIG_CLAUDE=/srv/agence-ia/claude-config
# Ne jamais définir ANTHROPIC_API_KEY : Claude Code l'utiliserait à la place de l'abonnement (facturation API).

# --- Interface web ---
# 127.0.0.1 sur le VPS (derrière Caddy) ; 0.0.0.0 pour y accéder depuis le téléphone en Wi-Fi local.
HOTE_WEB=127.0.0.1
PORT_WEB=8000
# Écrits par la commande `agence mot-de-passe` (ne pas remplir à la main).
MOT_DE_PASSE_INTERFACE=
SECRET_SESSION=

# --- Notifications push sur le téléphone (app ntfy) ---
# Sujet secret : `agence notification sujet` en crée un et l'écrit ici. Vide : pas de notification.
NTFY_SUJET=

# --- Instagram (API officielle de Meta) ---
# « oui » : chaque post validé est publié à son horaire prévu (entre 8 h et 22 h, heure de Paris).
# Laisser « non » tant que l'app Meta, le jeton et l'adresse publique ne sont pas prêts.
PUBLICATION_AUTOMATIQUE=non
INSTAGRAM_API_URL=https://graph.facebook.com/v23.0
# Identifiant du compte Instagram professionnel et jeton d'accès (secret), donnés par l'app Meta.
INSTAGRAM_COMPTE_ID=
INSTAGRAM_JETON=
